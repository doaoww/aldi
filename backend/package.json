{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "prisma migrate deploy && next start",
    "seed": "tsx prisma/seed.ts",
    "postinstall": "prisma generate",
    "db:dev": "node scripts/dev-db.mjs",
    "create-doctor": "tsx scripts/create-doctor.ts",
    "test": "vitest run tests/unit && node --test src/infrastructure/llm/*.test.mjs",
    "test:e2e": "vitest run tests/e2e"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "next": "16.4.6",
    "prisma": "^6.19.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "embedded-postgres": "^18.6.0-beta.19",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
