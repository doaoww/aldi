# База
DATABASE_URL=postgresql://aldi:aldi@localhost:54329/aldi

# Фронтенд: точный список сайтов, которым разрешено обращаться к API (через запятую)
CORS_ORIGINS=http://localhost:5173

# Сессии
# lax — фронт и API на одном домене (через прокси /api/*), рекомендуется.
# none — фронт и API на разных доменах; cookie станет сторонней и может блокироваться браузером.
COOKIE_SAMESITE=lax
# true — дополнительно вернуть токен сессии в ответе на вход и принимать его в Authorization: Bearer.
# Нужно только если cookie между доменами не работает. Токен в JS менее защищён, чем HttpOnly-cookie.
AUTH_RETURN_TOKEN=false
SESSION_TTL_HOURS=168
INVITATION_TTL_HOURS=72

# Языковая модель (OpenRouter)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Голос (ElevenLabs). Общий агент и, при необходимости, отдельные агенты по языкам.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_AGENT_ID_RU=
ELEVENLABS_AGENT_ID_KK=
ELEVENLABS_AGENT_ID_UZ=
ELEVENLABS_AGENT_ID_EN=
# Секрет, с которым агент вызывает /api/tools/* (заголовок X-Tool-Secret)
TOOL_SECRET=

# 3D-файлы: если модели лежат на другом домене, укажите его; иначе оставьте пустым
ASSET_BASE_URL=

# Необязательно: уведомление врачу в Telegram (без медицинского текста)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DOCTOR_APP_URL=

# Только для разработки и тестов: заглушки вместо OpenRouter и ElevenLabs
# AI_MODE=fake
